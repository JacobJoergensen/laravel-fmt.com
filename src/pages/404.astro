---
import Layout from "../layouts/Layout.astro";
import BetaBanner from "../components/BetaBanner.astro";
import Nav from "../components/Nav.astro";
---

<Layout title="404: Page not found · Laravel Fmt" description="This page does not exist.">
    <BetaBanner />
    <Nav />
    <main id="main" tabindex="-1" class="scroll-mt-19 focus:outline-none">
        <section class="mx-auto flex min-h-[70vh] max-w-184 flex-col justify-center px-7 py-16">
            <span class="mb-6 font-display text-[clamp(64px,13vw,104px)] font-bold leading-[0.9] tracking-[-0.04em] text-red">
                404
            </span>

            <h1 class="mb-3.5 mt-0 font-display text-[clamp(26px,4vw,34px)] font-semibold leading-[1.12] tracking-[-0.02em]">
                Page not found.
            </h1>

            <p class="mb-8 mt-0 max-w-[52ch] text-[16.5px] leading-[1.65] text-muted">
                There is nothing at <code
                    class="req-path break-all rounded-md border border-border bg-surface px-1.5 py-0.5 font-mono text-[14px] text-text"
                    >this address</code
                >. It may have moved.
            </p>

            <div class="flex flex-wrap gap-3">
                <a
                    href="/"
                    class="inline-flex items-center gap-1.75 rounded-[9px] bg-red px-4.5 py-2.5 text-[13.5px] font-semibold text-white no-underline shadow-[0_8px_22px_-10px_rgba(255,45,32,0.4)] transition hover:bg-red-press active:translate-y-px"
                >
                    <span class="text-[15px]">&larr;</span> Back home
                </a>
                <a
                    href="/docs/getting-started"
                    class="inline-flex items-center gap-1.75 rounded-[9px] border border-border-strong px-4 py-2.5 text-[13.5px] font-medium text-text no-underline transition hover:bg-surface"
                >
                    Read the docs
                </a>
            </div>
        </section>
    </main>
</Layout>

<script is:inline>
    document.querySelectorAll(".req-path").forEach((el) => {
        el.textContent = window.location.pathname;
    });
</script>
