---
interface Props {
    size?: number;
    class?: string;
}

const { size = 16, class: className } = Astro.props;
---

<svg
    width={size}
    height={size}
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    aria-hidden="true"
    class={className}
>
    <circle cx="8" cy="8" r="3.1"></circle>
    <path d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M12.95 3.05l-1.13 1.13M4.18 11.82l-1.13 1.13"></path>
