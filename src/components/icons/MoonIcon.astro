    width={size}
    height={size}
    viewBox="0 0 16 16"
    fill="currentColor"
    aria-hidden="true"
    class={className}
>
    <path
        d="M13.9 10.6A6.2 6.2 0 0 1 5.4 2.1a.6.6 0 0 0-.8-.8 6.9 6.9 0 1 0 10.1 10.1.6.6 0 0 0-.8-.8Z"
    ></path>
