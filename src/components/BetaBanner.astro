---
const issuesUrl = "https://github.com/jacobjoergensen/laravel-fmt/issues";
---

<div class="flex items-center justify-center gap-2.5 border-b border-border bg-bg2 px-4 py-2.25 text-center text-[13px] text-muted">
    <span class="size-1.5 shrink-0 animate-pulse-dot rounded-full bg-cyan" aria-hidden="true"></span>
    <span>
    <span class="font-medium text-text">Laravel Fmt is in public beta.</span> Found a bug?{" "}
    <a href={issuesUrl} class="text-cyan-soft no-underline hover:underline">Open an issue&nbsp;&rarr;</a>
  </span>
</div>
